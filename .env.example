# ============================================================
# Villa Hola — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
# Production: BASE_URL=https://www.villahola.es

# ── Session secret (change to a long random string in production) ──
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ── Admin credentials ────────────────────────────────────────
# Change these before going live!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=VillaHola2024!

# ── Stripe ──────────────────────────────────────────────────
# Get your keys from https://dashboard.stripe.com/apikeys
# Use test keys during development, live keys in production
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ── WhatsApp ─────────────────────────────────────────────────
# Full number with country code, no spaces or dashes
# e.g. +34600123456
WHATSAPP_NUMBER=+34600000000

# ── Villa Pricing (€ per night) ─────────────────────────────
# Peak: Dec 20–Jan 6, Jan 13–21, Feb 26–Mar 11, May 29–Jun 6, Jul–Aug, Oct 23–31
PRICE_LOW_SEASON=325
PRICE_MID_SEASON=325
PRICE_HIGH_SEASON=395
MIN_STAY_NIGHTS=3
CLEANING_FEE=80
DEPOSIT_PERCENT=20
EARLY_BOOKING_DISCOUNT=10

# ── Email (optional — for booking confirmation emails) ───────
# Leave blank to disable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bookings@villahola.es
SMTP_PASS=your-app-password
EMAIL_FROM=Villa Hola <bookings@villahola.es>

# ── iCal / Channel Manager Integration ──────────────────────
# These will be filled in when Airbnb and Booking.com accounts exist.
# Leave blank for now — the system works without them.
AIRBNB_ICAL_URL=
BOOKINGCOM_ICAL_URL=

# ── iCal sync interval (minutes, for future use) ────────────
ICAL_SYNC_INTERVAL_MINUTES=60
